# ARM Linux：设备路径为待现场核实的默认值。外部环境变量优先。
# LPB3588 实机确认：PCA9685 位于 /dev/i2c-2，地址 0x40。
# X2P 伺服使用 LPB3588 板载 RS485，实机已确认设备为 /dev/ttyS0。
export CHASSIS_BACKEND="${CHASSIS_BACKEND:-serial}"
# USB1 -> FT232 USB-TTL -> STM32 USART2；固定序列号，避免ttyUSB编号变化。
export CHASSIS_SERIAL_PORT="${CHASSIS_SERIAL_PORT:-/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AB3N91KX-if00-port0}"
export GRAIN_SAMPLING_UI_RC_PUBLISH="${GRAIN_SAMPLING_UI_RC_PUBLISH:-0}"
export RC_RECEIVER_BACKEND="${RC_RECEIVER_BACKEND:-ibus}"
export RC_SERIAL_PORT="${RC_SERIAL_PORT:-/dev/rc_receiver}"
export RC_SERIAL_BAUDRATE="${RC_SERIAL_BAUDRATE:-115200}"
export RC_OUTPUT_MODE="${RC_OUTPUT_MODE:-cmd_vel}"
export MOTOR_DRIVER_HOST="${MOTOR_DRIVER_HOST:-127.0.0.1}"
export MOTOR_DRIVER_PORT="${MOTOR_DRIVER_PORT:-8765}"
export X2P_PORT="${X2P_PORT:-/dev/ttyS0}"
export PCA9685_I2C_BUS="${PCA9685_I2C_BUS:-2}"
export PCA9685_DT_ALIAS="${PCA9685_DT_ALIAS:-i2c2}"
export PCA9685_I2C_ADDRESS="${PCA9685_I2C_ADDRESS:-0x40}"
export PCA9685_I2C_DEVICE="${PCA9685_I2C_DEVICE:-/dev/i2c-$PCA9685_I2C_BUS}"
export GRICP_BIND_IP="${GRICP_BIND_IP:-192.168.50.1}"
export GRICP_ALLOWED_PEER="${GRICP_ALLOWED_PEER:-192.168.50.2}"
export GRICP_TLS_CERT="${GRICP_TLS_CERT:-/etc/grain-robot/tls/3588.crt}"
export GRICP_TLS_KEY="${GRICP_TLS_KEY:-/etc/grain-robot/tls/3588.key}"
export GRICP_TLS_CA="${GRICP_TLS_CA:-/etc/grain-robot/tls/ca.crt}"
export GRAIN_ROBOT_SOCKET="${GRAIN_ROBOT_SOCKET:-/run/grain-robot/control.sock}"
