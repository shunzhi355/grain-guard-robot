# ARM Linux：设备路径为待现场核实的默认值。外部环境变量优先。
# LPB3588 实机确认：PCA9685 位于 /dev/i2c-2，地址 0x40。
# USB1/USB3 是物理端口，不代表 ttyUSB 编号。
export MOTOR_DRIVER_BACKEND="${MOTOR_DRIVER_BACKEND:-pca9685}"
export RC_RECEIVER_BACKEND="${RC_RECEIVER_BACKEND:-ibus}"
export RC_SERIAL_PORT="${RC_SERIAL_PORT:-/dev/rc_receiver}"
export RC_SERIAL_BAUDRATE="${RC_SERIAL_BAUDRATE:-115200}"
export RC_OUTPUT_MODE="${RC_OUTPUT_MODE:-cmd_vel}"
export MOTOR_DRIVER_HOST="${MOTOR_DRIVER_HOST:-127.0.0.1}"
export MOTOR_DRIVER_PORT="${MOTOR_DRIVER_PORT:-8765}"
export X2P_PORT="${X2P_PORT:-/dev/x2p_lift}"
export PCA9685_I2C_BUS="${PCA9685_I2C_BUS:-2}"
export PCA9685_I2C_ADDRESS="${PCA9685_I2C_ADDRESS:-0x40}"
export PCA9685_I2C_DEVICE="${PCA9685_I2C_DEVICE:-/dev/i2c-2}"
