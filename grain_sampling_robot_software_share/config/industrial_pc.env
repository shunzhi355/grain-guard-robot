# ARM Linux：设备路径为待现场核实的默认值。外部环境变量优先。
# USB1/USB3 是物理端口，不代表 ttyUSB 编号。
export MOTOR_DRIVER_BACKEND="${MOTOR_DRIVER_BACKEND:-pca9685}"
export RC_RECEIVER_BACKEND="${RC_RECEIVER_BACKEND:-ibus}"
export RC_SERIAL_PORT="${RC_SERIAL_PORT:-/dev/ttyUSB0}"
export RC_SERIAL_BAUDRATE="${RC_SERIAL_BAUDRATE:-115200}"
export X2P_PORT="${X2P_PORT:-/dev/ttyUSB1}"
export PCA9685_I2C_BUS="${PCA9685_I2C_BUS:-2}"
export PCA9685_I2C_ADDRESS="${PCA9685_I2C_ADDRESS:-0x40}"
export PCA9685_I2C_DEVICE="${PCA9685_I2C_DEVICE:-}"
