[Unit]
Description=Grain robot RC to PCA9685 PWM test
After=multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory="/home/neardi/project/grain guard robot/grain-guard-robot/grain_sampling_robot_software_share"
Environment="PYTHONUNBUFFERED=1"
Environment="MOTOR_DRIVER_BACKEND=pca9685"
Environment="PCA9685_I2C_BUS=2"
Environment="PCA9685_I2C_DEVICE=/dev/i2c-2"
Environment="PCA9685_I2C_ADDRESS=0x40"
Environment="RC_SERIAL_PORT=/dev/ttyUSB0"
Environment="RC_SERIAL_BAUDRATE=115200"
ExecStart=/usr/bin/python3 "/home/neardi/project/grain guard robot/grain-guard-robot/grain_sampling_robot_software_share/dipan/rc_pwm_test.py"
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
