[Unit]
Description=Grain Sampling Robot ROS1 Hardware Stack
After=network.target
Wants=network.target
Conflicts=grain-rc-pwm-test.service

[Service]
Type=oneshot
User=neardi
Group=neardi
SupplementaryGroups=dialout i2c
Environment="HOME=/home/neardi"
Environment="PYTHONUNBUFFERED=1"
Environment="MECHANISM_WS_SETUP=/home/neardi/mechanism_ws/devel/setup.bash"
RemainAfterExit=yes
ExecStart=/bin/bash "/home/neardi/project/grain guard robot/grain-guard-robot/grain_sampling_robot_software_share/scripts/start_industrial_pc.sh"
ExecStop=/bin/bash "/home/neardi/project/grain guard robot/grain-guard-robot/grain_sampling_robot_software_share/scripts/stop_industrial_pc.sh"
TimeoutStartSec=30
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
