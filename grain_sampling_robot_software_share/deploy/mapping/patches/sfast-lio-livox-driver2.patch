new file mode 100644
index 0000000..20743b3
--- /dev/null
+++ b/launch/mapping_mid360_relocalization.launch
@@ -0,0 +1,8 @@
+<launch>
+  <arg name="rviz" default="false" />
+  <rosparam command="load" file="$(find sfast_lio)/config/mid360.yaml" />
+  <node pkg="sfast_lio" type="fastlio_mapping_re" name="laserMapping" output="screen" />
+  <group if="$(arg rviz)">
+    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find sfast_lio)/rviz_cfg/loam_livox.rviz" />
+  </group>
+</launch>
