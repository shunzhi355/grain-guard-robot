diff --git a/launch/mapping_mid360.launch b/launch/mapping_mid360.launch
new file mode 100644
index 0000000..eb0e01b
--- /dev/null
+++ b/launch/mapping_mid360.launch
@@ -0,0 +1,8 @@
+<launch>
+  <arg name="rviz" default="false" />
+  <rosparam command="load" file="$(find sfast_lio)/config/mid360.yaml" />
+  <node pkg="sfast_lio" type="sfastlio_mapping" name="laserMapping" output="screen" />
+  <group if="$(arg rviz)">
+    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find sfast_lio)/rviz_cfg/loam_livox.rviz" />
+  </group>
+</launch>
