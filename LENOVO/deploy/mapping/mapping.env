# Mapping runtime defaults. Every value may be overridden by the caller.
export RADAR_NETDEV="${RADAR_NETDEV:-eth1}"
export LIVOX_WS="${LIVOX_WS:-${HOME}/fastlio_ws}"
export SFAST_WS="${SFAST_WS:-${HOME}/fastlio2_ws}"
export LIVOX_PACKAGE="${LIVOX_PACKAGE:-livox_ros_driver2}"
export LIVOX_LAUNCH="${LIVOX_LAUNCH:-msg_MID360.launch}"
export LIVOX_LIDAR_TOPIC="${LIVOX_LIDAR_TOPIC:-/livox/lidar}"
export LIVOX_IMU_TOPIC="${LIVOX_IMU_TOPIC:-/livox/imu}"
export SFAST_PACKAGE="${SFAST_PACKAGE:-sfast_lio}"
export SFAST_MAPPING_EXECUTABLE="${SFAST_MAPPING_EXECUTABLE:-${SFAST_WS}/devel/lib/sfast_lio/sfastlio_mapping}"
export SFAST_CONFIG="${SFAST_CONFIG:-${SFAST_WS}/src/S-FAST_LIO/config/mid360.yaml}"
export SFAST_RELOCALIZATION_LAUNCH="${SFAST_RELOCALIZATION_LAUNCH:-mapping_mid360_relocalization.launch}"
export MAPPING_TOPIC_WAIT_SECONDS="${MAPPING_TOPIC_WAIT_SECONDS:-30}"
